{
  "rewrites": [
    { "source": "/AUTHENTICATE/:path*", "destination": "/" },
    { "source": "/verify/:path*", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
